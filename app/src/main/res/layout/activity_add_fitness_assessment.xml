<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">


        <!-- ================================================= -->
        <!-- TOP BAR                                           -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Add Fitness Assessment"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ASSESSMENT INFORMATION                            -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Assessment Information"
            android:textColor="@color/green_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="@color/login_stroke" />


        <!-- ================================================= -->
        <!-- DATE                                              -->
        <!-- ================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutAssessmentDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Assessment Date"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/text_input_stroke"
            app:hintTextColor="@color/text_input_hint"
            app:boxStrokeWidth="1dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtAssessmentDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/hint" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ================================================= -->
        <!-- BODY MEASUREMENTS                                 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Body Measurements"
            android:textColor="@color/green_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="@color/login_stroke" />


        <!-- ================================================= -->
        <!-- WEIGHT / HEIGHT                                   -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutWeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="Weight (kg)"
                app:boxStrokeWidth="1dp"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/text_input_stroke"
                app:hintTextColor="@color/text_input_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutHeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="Height (cm)"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/text_input_stroke"
                app:hintTextColor="@color/text_input_hint"
                app:boxStrokeWidth="1dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- BODY FAT / CHEST                                  -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutBodyFat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="Body Fat (%)"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/text_input_stroke"
                app:hintTextColor="@color/text_input_hint"
                app:boxStrokeWidth="1dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtBodyFat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutChest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="Chest (cm)"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/text_input_stroke"
                app:hintTextColor="@color/text_input_hint"
                app:boxStrokeWidth="1dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtChest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- WAIST / HIPS                                     -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutWaist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="Waist (cm)"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/text_input_stroke"
                app:hintTextColor="@color/text_input_hint"
                app:boxStrokeWidth="1dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtWaist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutHips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="Hips (cm)"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/text_input_stroke"
                app:hintTextColor="@color/text_input_hint"
                app:boxStrokeWidth="1dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtHips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ARMS / THIGH                                     -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutArms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="Arms (cm)"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/text_input_stroke"
                app:hintTextColor="@color/text_input_hint"
                app:boxStrokeWidth="1dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtArms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutThigh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="Thigh (cm)"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/text_input_stroke"
                app:hintTextColor="@color/text_input_hint"
                app:boxStrokeWidth="1dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtThigh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- NOTES                                             -->
        <!-- ================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Notes"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/text_input_stroke"
            app:hintTextColor="@color/text_input_hint"
            app:boxStrokeWidth="1dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtNotes"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/hint" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ================================================= -->
        <!-- PROGRESS PHOTOS                                   -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Progress Photos"
            android:textColor="@color/green_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="@color/login_stroke" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">


            <!-- ================================================= -->
            <!-- FRONT                                             -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgFront"
                    android:layout_width="150dp"
                    android:layout_height="180dp"
                    android:background="@drawable/bg_member_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Front"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFrontPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="4dp"
                    android:text="Add Photo"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    app:backgroundTint="@color/green_primary"
                    app:cornerRadius="8dp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SIDE                                              -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgSide"
                    android:layout_width="150dp"
                    android:layout_height="180dp"
                    android:background="@drawable/bg_member_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Side"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSidePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="4dp"
                    android:text="Add Photo"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    app:backgroundTint="@color/green_primary"
                    app:cornerRadius="8dp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- BACK                                              -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgBack"
                    android:layout_width="150dp"
                    android:layout_height="180dp"
                    android:background="@drawable/bg_member_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Back"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="4dp"
                    android:text="Add Photo"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    app:backgroundTint="@color/green_primary"
                    app:cornerRadius="8dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ACTION BUTTONS                                    -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/login_stroke"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveFitness"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Save Assessment"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/green_primary"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>