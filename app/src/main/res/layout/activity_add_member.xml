<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/login_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">


        <!-- ================================================= -->
        <!-- TOP BAR                                           -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Add Member"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- MAIN CONTENT                                      -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">


            <!-- ================================================= -->
            <!-- LEFT : PHOTO                                      -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="220dp"
                    android:layout_height="260dp"
                    app:cardBackgroundColor="@color/login_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgMemberPhoto"
                            android:layout_width="170dp"
                            android:layout_height="170dp"
                            android:contentDescription="Member photo"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_person"
                            app:shapeAppearanceOverlay="@style/CircleImageView"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Member Photo"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCamera"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:text="Camera"
                        android:textColor="@color/green_primary"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:backgroundTint="@null"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGallery"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:text="Gallery"
                        android:textColor="@color/green_primary"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:backgroundTint="@null"
                        app:cornerRadius="10dp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- RIGHT : MEMBER INFORMATION                        -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <!-- ================================================= -->
                <!-- PERSONAL INFORMATION                              -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Personal Information"
                    android:textColor="@color/green_light"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/text_secondary" />


                <!-- FIRST / LAST NAME -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="First Name"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/text_input_stroke"
                        app:hintTextColor="@color/text_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtFirstName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:inputType="textPersonName"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Last Name"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/text_input_stroke"
                        app:hintTextColor="@color/text_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtLastName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:inputType="textPersonName"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>


                <!-- FULL NAME -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Full Name *"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/text_input_stroke"
                    app:hintTextColor="@color/text_input_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:inputType="textPersonName"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- GENDER / DOB -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Gender"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/text_input_stroke"
                        app:hintTextColor="@color/text_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtGender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:focusable="false"
                            android:inputType="none" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Date of Birth"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/text_input_stroke"
                        app:hintTextColor="@color/text_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtDateOfBirth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:focusable="false"
                            android:inputType="none" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>


                <!-- NIC / MOBILE -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="NIC"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/text_input_stroke"
                        app:hintTextColor="@color/text_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtNic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:inputType="text"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Mobile"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/text_input_stroke"
                        app:hintTextColor="@color/text_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtMobile"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:inputType="phone"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>


                <!-- EMAIL -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Email"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/text_input_stroke"
                    app:hintTextColor="@color/text_input_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:inputType="textEmailAddress"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- ADDRESS / CITY -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="2"
                        android:hint="Address"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/text_input_stroke"
                        app:hintTextColor="@color/text_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:inputType="textPostalAddress"
                            android:maxLines="2" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="City"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/text_input_stroke"
                        app:hintTextColor="@color/text_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtCity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:inputType="textCapWords"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- EMERGENCY CONTACT                                  -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Emergency Contact"
                    android:textColor="@color/green_light"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/text_secondary" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Contact Name"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/text_input_stroke"
                        app:hintTextColor="@color/text_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtEmergencyContactName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:inputType="textPersonName"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Contact Mobile"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/text_input_stroke"
                        app:hintTextColor="@color/text_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtEmergencyContactMobile"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:inputType="phone"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>


                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Relationship"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/text_input_stroke"
                    app:hintTextColor="@color/text_input_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtEmergencyContactRelationship"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:inputType="textCapWords"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- ================================================= -->
                <!-- HEALTH & PROFILE                                  -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Health &amp; Profile"
                    android:textColor="@color/green_light"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/text_secondary" />


                <!-- OCCUPATION / BLOOD GROUP -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Occupation"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/text_input_stroke"
                        app:hintTextColor="@color/text_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtOccupation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:inputType="textCapWords"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Blood Group"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/text_input_stroke"
                        app:hintTextColor="@color/text_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtBloodGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:focusable="false"
                            android:inputType="none"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>


                <!-- MEDICAL CONDITIONS -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Medical Conditions"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/text_input_stroke"
                    app:hintTextColor="@color/text_input_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtMedicalConditions"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:textColor="@color/text_primary"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:maxLines="4" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- GOAL -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Fitness Goal"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/text_input_stroke"
                    app:hintTextColor="@color/text_input_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtGoal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- NOTES -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Notes"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/text_input_stroke"
                    app:hintTextColor="@color/text_input_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtNotes"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:textColor="@color/text_primary"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:maxLines="5" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- ================================================= -->
                <!-- BRANCH & JOIN DATE                                -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Gym Information"
                    android:textColor="@color/green_light"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/text_secondary" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Branch *"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/text_input_stroke"
                        app:hintTextColor="@color/text_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtBranch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:focusable="false"
                            android:inputType="none" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Join Date *"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/text_input_stroke"
                        app:hintTextColor="@color/text_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtJoinDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:focusable="false"
                            android:inputType="none" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- BUTTONS                                           -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancel"
                        android:layout_width="120dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="Cancel"
                        android:textColor="@color/green_primary"
                        android:textAllCaps="false"
                        app:backgroundTint="@null"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveMember"
                        android:layout_width="150dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_button_primary"
                        android:text="Save Member"
                        android:textColor="@android:color/white"
                        android:textAllCaps="false"
                        app:backgroundTint="@null"
                        app:cornerRadius="10dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>