<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/login_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <!-- ================================================= -->
        <!-- TOP BAR                                           -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Membership"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtMemberName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ahmed Mohamed"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- MEMBERSHIP INFORMATION                            -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">


            <!-- LEFT -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_dashboard_card">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Membership Details"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>


                <!-- BRANCH -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutBranch"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Branch"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/text_input_stroke"
                    app:hintTextColor="@color/text_input_hint"
                    app:endIconMode="dropdown_menu">

                    <AutoCompleteTextView
                        android:id="@+id/txtBranch"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:inputType="none"
                        android:textColor="@color/text_primary"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>

                </com.google.android.material.textfield.TextInputLayout>


                <!-- PLAN -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutPlan"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Membership Plan"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/text_input_stroke"
                    app:hintTextColor="@color/text_input_hint"
                    app:endIconMode="dropdown_menu">

                    <AutoCompleteTextView
                        android:id="@+id/txtPlan"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:inputType="none"
                        android:textColor="@color/text_primary"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>

                </com.google.android.material.textfield.TextInputLayout>


                <!-- START DATE -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutStartDate"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Start Date"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/text_input_stroke"
                    app:hintTextColor="@color/text_input_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtStartDate"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:clickable="true"
                        android:focusable="false"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/hint"
                        android:background="@null"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>


            <!-- RIGHT -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_dashboard_card">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price Summary"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Plan Price"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/txtPlanPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Rs. 0.00"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"/>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Joining Fee"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/txtJoiningFee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Rs. 0.00"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"/>


                <!-- DISCOUNT -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutDiscount"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:hint="Discount"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/text_input_stroke"
                    app:hintTextColor="@color/text_input_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtDiscount"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:inputType="numberDecimal"
                        android:text="0.00"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/hint"
                        android:background="@null"/>

                </com.google.android.material.textfield.TextInputLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/login_stroke"/>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Total Membership Amount"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/txtTotalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Rs. 0.00"
                    android:textColor="@color/green_light"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- NOTES                                             -->
        <!-- ================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNotes"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Notes"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/text_input_stroke"
            app:hintTextColor="@color/text_input_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtNotes"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/hint"
                android:background="@null"/>

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ================================================= -->
        <!-- CREATE BUTTON                                     -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateMembership"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:text="CREATE MEMBERSHIP"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/green_primary"
            app:cornerRadius="10dp"/>

    </LinearLayout>

</ScrollView>