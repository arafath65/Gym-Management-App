<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"
    android:padding="22dp"
    android:background="@color/login_card">


    <!-- HEADER -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="Assign Program"

        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"/>


    <TextView
        android:id="@+id/txtAssignProgramMember"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="4dp"

        android:text="Assign a program to this membership"

        android:textColor="@color/text_secondary"
        android:textSize="12sp"/>


    <!-- PROGRAM -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutProgram"

        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="20dp"

        android:hint="Program"

        app:boxBackgroundColor="@color/login_card"
        app:boxStrokeColor="@color/login_stroke"
        app:hintTextColor="@color/hint">


        <AutoCompleteTextView
            android:id="@+id/autoProgram"

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:inputType="none"

            android:paddingStart="14dp"
            android:paddingEnd="14dp"

            android:textColor="@color/text_primary"
            android:textColorHint="@color/hint"/>

    </com.google.android.material.textfield.TextInputLayout>


    <!-- PROGRAM INFO -->

    <!-- ================================================= -->
    <!-- PROGRAM INFO                                      -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/programInfoContainer"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="12dp"

        android:orientation="horizontal"

        android:visibility="gone">


        <!-- ============================================= -->
        <!-- DURATION                                      -->
        <!-- ============================================= -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="DURATION"

                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:textStyle="bold"/>


            <TextView
                android:id="@+id/txtSelectedDuration"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="-"

                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- ============================================= -->
        <!-- BRANCH                                        -->
        <!-- ============================================= -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="BRANCH"

                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:textStyle="bold"/>


            <TextView
                android:id="@+id/txtSelectedBranch"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="-"

                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"

                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>


        <!-- ============================================= -->
        <!-- PROGRAM FEE                                   -->
        <!-- ============================================= -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="PROGRAM FEE"

                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:textStyle="bold"/>


            <TextView
                android:id="@+id/txtSelectedFee"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="Rs. 0.00"

                android:textColor="@color/green_light"
                android:textSize="13sp"
                android:textStyle="bold"

                android:maxLines="1"/>

        </LinearLayout>

    </LinearLayout>


    <!-- START DATE -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutStartDate"

        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="15dp"

        android:hint="Start Date"

        app:boxBackgroundColor="@color/login_card"
        app:boxStrokeColor="@color/login_stroke"
        app:hintTextColor="@color/hint">


        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txtAssignStartDate"

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:focusable="false"
            android:clickable="true"

            android:textColor="@color/text_primary"
            android:textColorHint="@color/hint"
            android:background="@null"/>

    </com.google.android.material.textfield.TextInputLayout>


    <!-- END DATE -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutEndDate"

        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="12dp"

        android:hint="End Date"

        app:boxBackgroundColor="@color/login_card"
        app:boxStrokeColor="@color/login_stroke"
        app:hintTextColor="@color/hint">


        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txtAssignEndDate"

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:focusable="false"

            android:textColor="@color/text_primary"
            android:textColorHint="@color/hint"
            android:background="@null"/>

    </com.google.android.material.textfield.TextInputLayout>


    <!-- NOTES -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutAssignNotes"

        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="12dp"

        android:hint="Notes (Optional)"

        app:boxBackgroundColor="@color/login_card"
        app:boxStrokeColor="@color/login_stroke"
        app:hintTextColor="@color/hint">


        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txtAssignNotes"

            android:layout_width="match_parent"
            android:layout_height="90dp"

            android:gravity="top"

            android:inputType="textMultiLine"

            android:textColor="@color/text_primary"
            android:textColorHint="@color/hint"
            android:background="@null"/>

    </com.google.android.material.textfield.TextInputLayout>


    <!-- BUTTONS -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="20dp"

        android:gravity="end"

        android:orientation="horizontal">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelAssignProgram"

            android:layout_width="wrap_content"
            android:layout_height="46dp"

            android:text="Cancel"
            android:textAllCaps="false"

            android:textColor="@color/text_primary"

            app:backgroundTint="@color/login_stroke"/>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAssignProgram"

            android:layout_width="wrap_content"
            android:layout_height="46dp"

            android:layout_marginStart="10dp"

            android:text="Assign Program"
            android:textAllCaps="false"

            android:textColor="@android:color/white"

            app:backgroundTint="@color/green_primary"/>

    </LinearLayout>

</LinearLayout>