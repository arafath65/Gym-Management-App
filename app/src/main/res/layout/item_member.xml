<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp">


    <!-- ================================================= -->
    <!-- MEMBER CARD                                      -->
    <!-- ================================================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/memberCard"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:cardBackgroundColor="@color/login_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"
            android:padding="14dp">


            <!-- ========================================= -->
            <!-- MEMBER MAIN INFORMATION                   -->
            <!-- ========================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal">


                <!-- MEMBER PHOTO -->

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgMember"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_member_image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user"
                    app:shapeAppearanceOverlay="@style/CircleImageView"/>


                <!-- MEMBER DETAILS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"
                    android:layout_marginStart="12dp"

                    android:orientation="vertical">


                    <!-- NAME + MORE -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="center_vertical"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/txtMemberName"

                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:text="Ahmed Mohamed"

                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"

                            android:maxLines="1"
                            android:ellipsize="end"/>


                        <!-- THREE DOT -->

                        <ImageButton
                            android:id="@+id/btnMemberMore"

                            android:layout_width="34dp"
                            android:layout_height="34dp"

                            android:background="@drawable/bg_icon_button"

                            android:src="@drawable/ic_more"

                            android:contentDescription="More"/>

                    </LinearLayout>


                    <!-- MEMBER NUMBER -->

                    <TextView
                        android:id="@+id/txtMemberNo"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:text="FIT001-M00001"

                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"

                        android:maxLines="1"/>


                    <!-- MOBILE -->

                    <TextView
                        android:id="@+id/txtMemberMobile"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="5dp"

                        android:text="0771234567"

                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>


                    <!-- BRANCH -->

                    <TextView
                        android:id="@+id/txtMemberBranch"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="2dp"

                        android:text="Colombo"

                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ========================================= -->
            <!-- DIVIDER                                   -->
            <!-- ========================================= -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"

                android:layout_marginTop="12dp"

                android:background="@color/border_color"/>


            <!-- ========================================= -->
            <!-- MEMBERSHIP + STATUS                       -->
            <!-- ========================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="10dp"

                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/txtMembership"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:text="MONTHLY"

                    android:textColor="@color/green_light"
                    android:textSize="11sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtMembershipStatus"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="ACTIVE"

                    android:textColor="@color/green_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>