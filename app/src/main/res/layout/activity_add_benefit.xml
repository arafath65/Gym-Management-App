<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="@color/login_background">


    <!-- ================================================= -->
    <!-- HEADER                                            -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"

        android:gravity="center_vertical"

        android:paddingStart="20dp"
        android:paddingEnd="20dp">


        <ImageButton
            android:id="@+id/btnBack"

            android:layout_width="44dp"
            android:layout_height="44dp"

            android:background="@drawable/bg_icon_button"

            android:src="@drawable/ic_arrow_back"

            android:contentDescription="Back"/>


        <TextView
            android:id="@+id/txtScreenTitle"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:layout_marginStart="14dp"

            android:text="Add Benefit"

            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"/>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- CONTENT                                           -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:fillViewport="true"

        android:clipToPadding="false">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="10dp"
            android:paddingBottom="30dp">


            <!-- ========================================= -->
            <!-- BENEFIT CODE                              -->
            <!-- ========================================= -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutBenefitCode"

                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Benefit Code"

                app:boxBackgroundColor="@color/login_card"
                app:boxStrokeColor="@color/login_stroke"
                app:hintTextColor="@color/hint">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtBenefitCode"

                    android:layout_width="match_parent"
                    android:layout_height="56dp"

                    android:singleLine="true"

                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint"

                    android:background="@null"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ========================================= -->
            <!-- BENEFIT NAME                              -->
            <!-- ========================================= -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutBenefitName"

                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                android:hint="Benefit Name"

                app:boxBackgroundColor="@color/login_card"
                app:boxStrokeColor="@color/login_stroke"
                app:hintTextColor="@color/hint">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtBenefitName"

                    android:layout_width="match_parent"
                    android:layout_height="56dp"

                    android:singleLine="true"

                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint"

                    android:background="@null"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ========================================= -->
            <!-- DESCRIPTION                              -->
            <!-- ========================================= -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutBenefitDescription"

                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                android:hint="Description"

                app:boxBackgroundColor="@color/login_card"
                app:boxStrokeColor="@color/login_stroke"
                app:hintTextColor="@color/hint">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtBenefitDescription"

                    android:layout_width="match_parent"
                    android:layout_height="110dp"

                    android:gravity="top|start"

                    android:inputType="textMultiLine"

                    android:maxLines="4"

                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint"

                    android:background="@null"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ========================================= -->
            <!-- BILLING TYPE                              -->
            <!-- ========================================= -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutBenefitBillingType"

                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                android:hint="Billing Type"

                app:boxBackgroundColor="@color/login_card"
                app:boxStrokeColor="@color/login_stroke"
                app:hintTextColor="@color/hint">


                <AutoCompleteTextView
                    android:id="@+id/txtBenefitBillingType"

                    android:layout_width="match_parent"
                    android:layout_height="56dp"

                    android:inputType="none"

                    android:text="One Time"

                    android:textColor="@color/text_primary"

                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ========================================= -->
            <!-- DEFAULT FEE                               -->
            <!-- ========================================= -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutBenefitFee"

                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                android:hint="Default Fee"

                app:boxBackgroundColor="@color/login_card"
                app:boxStrokeColor="@color/login_stroke"
                app:hintTextColor="@color/hint">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtBenefitFee"

                    android:layout_width="match_parent"
                    android:layout_height="56dp"

                    android:inputType="numberDecimal"

                    android:singleLine="true"

                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint"

                    android:background="@null"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ========================================= -->
            <!-- BRANCH AVAILABILITY                       -->
            <!-- ========================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="22dp"

                android:text="Branch Availability"

                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:text="Choose where this benefit can be used."

                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>


            <!-- ========================================= -->
            <!-- BRANCH MODE                               -->
            <!-- ========================================= -->

            <RadioGroup
                android:id="@+id/radioBenefitBranchMode"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="10dp"

                android:orientation="vertical">


                <RadioButton
                    android:id="@+id/radioBenefitAllBranches"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="All Branches"

                    android:textColor="@color/text_primary"

                    android:checked="true"/>


                <RadioButton
                    android:id="@+id/radioBenefitSelectedBranches"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Selected Branches"

                    android:textColor="@color/text_primary"/>

            </RadioGroup>


            <!-- ========================================= -->
            <!-- BRANCH SELECTION                          -->
            <!-- ========================================= -->

            <LinearLayout
                android:id="@+id/layoutBenefitBranches"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="6dp"

                android:orientation="vertical"

                android:visibility="gone">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Select branches"

                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>


                <LinearLayout
                    android:id="@+id/branchContainer"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="6dp"

                    android:orientation="vertical"

                    android:padding="8dp"

                    android:background="@color/login_card"/>

            </LinearLayout>


            <!-- ========================================= -->
            <!-- BUTTONS                                   -->
            <!-- ========================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="28dp"

                android:gravity="end"

                android:orientation="horizontal">


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"

                    android:layout_width="130dp"
                    android:layout_height="52dp"

                    android:text="Cancel"

                    android:textAllCaps="false"

                    android:textColor="@color/text_primary"

                    app:backgroundTint="@color/login_card"
                    app:strokeColor="@color/login_stroke"
                    app:strokeWidth="1dp"/>


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveBenefit"

                    android:layout_width="180dp"
                    android:layout_height="52dp"

                    android:layout_marginStart="12dp"

                    android:text="Save Benefit"

                    android:textAllCaps="false"

                    android:textColor="@android:color/white"

                    android:textStyle="bold"

                    app:backgroundTint="@color/green_primary"/>

            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</LinearLayout>