<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background_dark">


    <!-- ===================================================== -->
    <!-- LEFT NAVIGATION -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutSidebar"

        android:layout_width="230dp"
        android:layout_height="0dp"

        android:orientation="vertical"

        android:paddingTop="22dp"
        android:paddingBottom="18dp"

        android:background="@color/sidebar_background"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">


        <!-- ================================================= -->
        <!-- LOGO / BRAND -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"

            android:gravity="center_vertical"

            android:paddingStart="24dp"
            android:paddingEnd="20dp">


            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"

                android:src="@drawable/ic_gym"

                android:contentDescription="@null"

                app:tint="@color/green_primary"/>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="12dp"

                android:text="FITFLOOR"

                android:textColor="@color/text_primary"

                android:textSize="20sp"
                android:textStyle="bold"

                android:letterSpacing="0.08"/>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- NAVIGATION -->
        <!-- ================================================= -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"

            android:layout_weight="1"

            android:fillViewport="true">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:paddingTop="18dp">


                <!-- ================================================= -->
                <!-- DASHBOARD -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/navDashboard"

                    android:layout_width="match_parent"
                    android:layout_height="54dp"

                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"

                    android:gravity="center_vertical"

                    android:paddingStart="16dp">


                    <ImageView
                        android:id="@+id/iconDashboard"

                        android:layout_width="24dp"
                        android:layout_height="24dp"

                        android:src="@drawable/ic_dashboard"

                        android:contentDescription="@null"

                        app:tint="@color/text_secondary"/>


                    <TextView
                        android:id="@+id/textDashboard"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="15dp"

                        android:text="Dashboard"

                        android:textColor="@color/text_secondary"

                        android:textSize="15sp"/>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- MEMBERS -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/navMembers"

                    android:layout_width="match_parent"
                    android:layout_height="54dp"

                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"

                    android:layout_marginTop="5dp"

                    android:gravity="center_vertical"

                    android:paddingStart="16dp">


                    <ImageView
                        android:id="@+id/iconMembers"

                        android:layout_width="24dp"
                        android:layout_height="24dp"

                        android:src="@drawable/ic_members"

                        android:contentDescription="@null"

                        app:tint="@color/text_secondary"/>


                    <TextView
                        android:id="@+id/textMembers"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="15dp"

                        android:text="Members"

                        android:textColor="@color/text_secondary"

                        android:textSize="15sp"/>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- MEMBERSHIP -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/navMembership"

                    android:layout_width="match_parent"
                    android:layout_height="54dp"

                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"

                    android:layout_marginTop="5dp"

                    android:gravity="center_vertical"

                    android:paddingStart="16dp">


                    <ImageView
                        android:id="@+id/iconMembership"

                        android:layout_width="24dp"
                        android:layout_height="24dp"

                        android:src="@drawable/ic_membership"

                        android:contentDescription="@null"

                        app:tint="@color/text_secondary"/>


                    <TextView
                        android:id="@+id/textMembership"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="15dp"

                        android:text="Plans"

                        android:textColor="@color/text_secondary"

                        android:textSize="15sp"/>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- PROGRAMS -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/navPrograms"
                    android:visibility="gone"

                    android:layout_width="match_parent"
                    android:layout_height="54dp"

                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"

                    android:layout_marginTop="5dp"

                    android:gravity="center_vertical"

                    android:paddingStart="16dp">


                    <ImageView
                        android:id="@+id/iconPrograms"

                        android:layout_width="24dp"
                        android:layout_height="24dp"

                        android:src="@drawable/ic_program"

                        android:contentDescription="@null"

                        app:tint="@color/text_secondary"/>


                    <TextView
                        android:id="@+id/textPrograms"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="15dp"

                        android:text="Programs"

                        android:textColor="@color/text_secondary"

                        android:textSize="15sp"/>

                </LinearLayout>

                <!-- ================================================= -->
                <!-- BENEFITS -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/navBenefits"
                    android:visibility="gone"

                    android:layout_width="match_parent"
                    android:layout_height="54dp"

                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"

                    android:layout_marginTop="5dp"

                    android:gravity="center_vertical"

                    android:paddingStart="16dp">


                    <ImageView
                        android:id="@+id/iconBenefits"

                        android:layout_width="24dp"
                        android:layout_height="24dp"

                        android:src="@drawable/ic_benefit"

                        android:contentDescription="@null"

                        app:tint="@color/text_secondary"/>


                    <TextView
                        android:id="@+id/textBenefits"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="15dp"

                        android:text="Benefits"

                        android:textColor="@color/text_secondary"

                        android:textSize="15sp"/>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- ATTENDANCE -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/navAttendance"

                    android:layout_width="match_parent"
                    android:layout_height="54dp"

                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"

                    android:layout_marginTop="5dp"

                    android:gravity="center_vertical"

                    android:paddingStart="16dp">


                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"

                        android:src="@drawable/ic_attendance"

                        android:contentDescription="@null"

                        app:tint="@color/text_secondary"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="15dp"

                        android:text="Attendance"

                        android:textColor="@color/text_secondary"

                        android:textSize="15sp"/>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- PAYMENTS -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/navPayments"

                    android:layout_width="match_parent"
                    android:layout_height="54dp"

                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"

                    android:layout_marginTop="5dp"

                    android:gravity="center_vertical"

                    android:paddingStart="16dp">


                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"

                        android:src="@drawable/ic_payment"

                        android:contentDescription="@null"

                        app:tint="@color/text_secondary"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="15dp"

                        android:text="Payments"

                        android:textColor="@color/text_secondary"

                        android:textSize="15sp"/>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- TRAINERS -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/navTrainers"

                    android:layout_width="match_parent"
                    android:layout_height="54dp"

                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"

                    android:layout_marginTop="5dp"

                    android:gravity="center_vertical"

                    android:paddingStart="16dp">


                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"

                        android:src="@drawable/ic_trainer"

                        android:contentDescription="@null"

                        app:tint="@color/text_secondary"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="15dp"

                        android:text="Trainers"

                        android:textColor="@color/text_secondary"

                        android:textSize="15sp"/>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- INVENTORY -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/navInventory"

                    android:layout_width="match_parent"
                    android:layout_height="54dp"

                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"

                    android:layout_marginTop="5dp"

                    android:gravity="center_vertical"

                    android:paddingStart="16dp">


                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"

                        android:src="@drawable/ic_inventory"

                        android:contentDescription="@null"

                        app:tint="@color/text_secondary"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="15dp"

                        android:text="Inventory"

                        android:textColor="@color/text_secondary"

                        android:textSize="15sp"/>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- REPORTS -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/navReports"

                    android:layout_width="match_parent"
                    android:layout_height="54dp"

                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"

                    android:layout_marginTop="5dp"

                    android:gravity="center_vertical"

                    android:paddingStart="16dp">


                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"

                        android:src="@drawable/ic_reports"

                        android:contentDescription="@null"

                        app:tint="@color/text_secondary"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="15dp"

                        android:text="Reports"

                        android:textColor="@color/text_secondary"

                        android:textSize="15sp"/>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- SETTINGS -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/navSettings"

                    android:layout_width="match_parent"
                    android:layout_height="54dp"

                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"

                    android:layout_marginTop="5dp"

                    android:gravity="center_vertical"

                    android:paddingStart="16dp">


                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"

                        android:src="@drawable/ic_settings"

                        android:contentDescription="@null"

                        app:tint="@color/text_secondary"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="15dp"

                        android:text="Settings"

                        android:textColor="@color/text_secondary"

                        android:textSize="15sp"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>


        <!-- ================================================= -->
        <!-- LOGOUT -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/navLogout"

            android:layout_width="match_parent"
            android:layout_height="54dp"

            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"

            android:gravity="center_vertical"

            android:paddingStart="16dp">


            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@drawable/ic_logout"

                android:contentDescription="@null"

                app:tint="@color/text_secondary"/>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="15dp"

                android:text="Logout"

                android:textColor="@color/text_secondary"

                android:textSize="15sp"/>

        </LinearLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- RIGHT SIDE -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutContent"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:orientation="vertical"

        app:layout_constraintStart_toEndOf="@id/layoutSidebar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">


        <!-- ================================================= -->
        <!-- TOP BAR -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutTopBar"

            android:layout_width="match_parent"
            android:layout_height="76dp"

            android:gravity="center_vertical"

            android:paddingStart="28dp"
            android:paddingEnd="28dp"

            android:background="@color/topbar_background">


            <!-- ================================================= -->
            <!-- GYM / BRANCH -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:orientation="vertical"

                android:gravity="center_vertical">


                <TextView
                    android:id="@+id/txtGymName"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Power World Fitness"

                    android:textColor="@color/text_primary"

                    android:textSize="17sp"
                    android:textStyle="bold"/>


                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutBranchSelector"

                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

                    android:layout_width="220dp"
                    android:layout_height="wrap_content"

                    android:hint="Branch"

                    app:boxBackgroundColor="@color/login_card"
                    app:boxStrokeColor="@color/login_stroke"
                    app:hintTextColor="@color/hint">


                    <AutoCompleteTextView
                        android:id="@+id/txtBranchSelector"

                        android:layout_width="match_parent"
                        android:layout_height="48dp"

                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"

                        android:singleLine="true"

                        android:inputType="none"

                        android:textColor="@color/text_primary"

                        android:textSize="13sp"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- USER -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/layoutUser"

                android:layout_width="wrap_content"
                android:layout_height="match_parent"

                android:gravity="center_vertical">


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:gravity="end">


                    <TextView
                        android:id="@+id/txtUserName"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Ahmed"

                        android:textColor="@color/text_primary"

                        android:textSize="14sp"
                        android:textStyle="bold"/>


                    <TextView
                        android:id="@+id/txtRoleName"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="2dp"

                        android:text="GYM OWNER"

                        android:textColor="@color/text_secondary"

                        android:textSize="11sp"/>

                </LinearLayout>


                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"

                    android:layout_marginStart="12dp"

                    android:gravity="center"

                    android:text="A"

                    android:textColor="@android:color/white"

                    android:textSize="16sp"
                    android:textStyle="bold"

                    android:background="@drawable/bg_profile_circle"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- FRAGMENT CONTENT -->
        <!-- ================================================= -->

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/dashboardContainer"

            android:layout_width="match_parent"
            android:layout_height="0dp"

            android:layout_weight="1"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>