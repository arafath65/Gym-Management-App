<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="10dp"

    app:cardBackgroundColor="@color/login_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="16dp">


        <!-- ================================================= -->
        <!-- HEADER                                           -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical">


                <TextView
                    android:id="@+id/txtRecordPlanName"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtRecordPlanCode"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="2dp"

                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"/>

            </LinearLayout>


            <TextView
                android:id="@+id/txtRecordState"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"

                android:textSize="10sp"
                android:textStyle="bold"

                android:textColor="@color/green_primary"

                android:background="@drawable/bg_status_active"/>


            <TextView
                android:id="@+id/txtRecordExpand"

                android:layout_width="32dp"
                android:layout_height="32dp"

                android:layout_marginStart="8dp"

                android:gravity="center"

                android:text="▼"

                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- BASIC DETAILS                                    -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="MEMBERSHIP NO."

                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtRecordMembershipNumber"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="START DATE"

                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtRecordStartDate"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="END DATE"

                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtRecordEndDate"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- FINANCIAL DETAILS - EXPANDABLE                   -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutRecordFinancial"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            android:paddingTop="12dp"

            android:orientation="horizontal"

            android:visibility="gone">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="TOTAL"

                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtRecordTotalAmount"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="PAID"

                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtRecordPaidAmount"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:textColor="@color/green_light"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="BALANCE"

                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtRecordBalanceAmount"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>