<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Members"
                android:textColor="@color/text_primary"
                android:textSize="25sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Manage gym members and memberships."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddMember"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="Add Member"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/green_primary"/>

    </LinearLayout>


    <!-- SEARCH -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutSearch"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:hint="Search member"
        app:boxBackgroundColor="@color/login_card"
        app:boxStrokeColor="@color/login_stroke"
        app:hintTextColor="@color/hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txtSearch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/hint"
            android:background="@null"/>

    </com.google.android.material.textfield.TextInputLayout>


    <!-- SUMMARY -->

    <TextView
        android:id="@+id/txtMemberCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Total Members: 0"
        android:textColor="@color/green_light"
        android:textSize="13sp"
        android:textStyle="bold"/>


    <!-- MEMBER LIST -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMembers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="15dp"
        android:clipToPadding="false"
        android:paddingBottom="15dp"/>

</LinearLayout>