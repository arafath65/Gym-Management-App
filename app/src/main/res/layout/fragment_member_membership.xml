<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:fillViewport="true"
    android:background="@color/login_background">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="18dp">

        <!-- ================================================= -->
        <!-- NO ACTIVE MEMBERSHIP                             -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"
            android:gravity="center"

            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="26dp"
            android:paddingBottom="26dp">


            <TextView
                android:id="@+id/txtNoMembership"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center"

                android:text="This member currently has no active membership."

                android:textColor="@color/text_secondary"
                android:textSize="14sp"

                android:visibility="gone"/>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateMembership"

                android:layout_width="220dp"
                android:layout_height="46dp"

                android:layout_marginTop="12dp"

                android:text="+ Create New Membership"

                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"

                android:textColor="@android:color/white"

                android:visibility="gone"

                app:cornerRadius="12dp"
                app:backgroundTint="@color/green_primary"/>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- CURRENT MEMBERSHIP                               -->
        <!-- ================================================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardCurrentMembership"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:visibility="gone"

            app:cardBackgroundColor="@color/login_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:padding="18dp">


                <!-- HEADER -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center_vertical">


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="CURRENT MEMBERSHIP"

                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold"/>


                        <TextView
                            android:id="@+id/txtPlanName"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="5dp"

                            android:textColor="@color/text_primary"
                            android:textSize="19sp"
                            android:textStyle="bold"/>


                        <TextView
                            android:id="@+id/txtPlanCode"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="3dp"

                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"/>


                        <TextView
                            android:id="@+id/txtMembershipNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>


                    <TextView
                        android:id="@+id/txtMembershipState"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"

                        android:textColor="@color/green_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"

                        android:background="@drawable/bg_status_active"/>

                </LinearLayout>


                <!-- DIVIDER -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"

                    android:layout_marginTop="15dp"

                    android:background="@color/border_color"/>


                <!-- MEMBERSHIP DETAILS: all key values on one row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="START DATE"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtStartDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="END DATE"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtEndDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtTotalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtTotalAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutBalanceColumn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BALANCE"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtBalanceAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                </LinearLayout>

                <!-- MEMBERSHIP ACTIONS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddToMembership"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:minWidth="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Change Membership Plan"
                        android:textAllCaps="false"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        app:cornerRadius="10dp"
                        app:backgroundTint="#287D78" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRenewMembership"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:minWidth="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Renew"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        app:cornerRadius="10dp"
                        app:backgroundTint="@color/green_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelMembership"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:minWidth="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Cancel Membership"
                        android:textAllCaps="false"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        app:cornerRadius="10dp"
                        app:backgroundTint="#C62828" />

                </LinearLayout>
            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================================================= -->
        <!-- CURRENT MEMBERSHIP BENEFITS                      -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutBenefitsSection"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="22dp"

            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Benefits"

                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"/>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="Benefits assigned to this membership"

                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMembershipBenefits"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="10dp"

                android:nestedScrollingEnabled="false"

                android:clipToPadding="false"

                android:paddingBottom="20dp"/>


            <TextView
                android:id="@+id/txtNoBenefits"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:padding="18dp"

                android:gravity="center"

                android:text="No benefits assigned."

                android:textColor="@color/text_secondary"
                android:textSize="12sp"

                android:visibility="gone"/>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- MEMBERSHIP HISTORY                               -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"

            android:orientation="vertical">


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"

                android:background="@color/border_color"/>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMembershipHistory"

                android:layout_width="match_parent"
                android:layout_height="46dp"

                android:layout_marginTop="16dp"

                android:text="Membership History"

                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"

                android:textColor="@color/text_primary"

                app:cornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_color"
                app:backgroundTint="@color/login_card"/>

        </LinearLayout>


    </LinearLayout>

</ScrollView>