<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"

    app:cardBackgroundColor="@color/login_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">


        <!-- ================================================= -->
        <!-- HEADER                                             -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/txtHistoryDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"

                android:text="11 Aug 2026"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"/>


            <TextView
                android:id="@+id/txtHistoryWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="78.5 kg"
                android:textColor="@color/green_light"
                android:textSize="13sp"
                android:textStyle="bold"/>


            <ImageButton
                android:id="@+id/btnFitnessMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"

                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Fitness assessment menu"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_secondary"/>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- MEASUREMENTS ROW 1                                 -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/txtHistoryBmi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"

                android:text="BMI 25.63"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>


            <TextView
                android:id="@+id/txtHistoryChest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"

                android:text="Chest 98 cm"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>


            <TextView
                android:id="@+id/txtHistoryWaist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"

                android:text="Waist 84 cm"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- MEASUREMENTS ROW 2                                 -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/txtHistoryHips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"

                android:text="Hips 96 cm"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>


            <TextView
                android:id="@+id/txtHistoryArms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"

                android:text="Arms 34 cm"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>


            <TextView
                android:id="@+id/txtHistoryThigh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"

                android:text="Thigh 55 cm"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- EXPANDABLE PHOTO SECTION                           -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutFitnessPhotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/login_stroke"/>


            <!-- ================================================= -->
            <!-- PHOTO ROW                                         -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">


                <!-- FRONT -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">


                    <ImageView
                        android:id="@+id/imgHistoryFront"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="Front fitness photo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_person"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"

                        android:text="Front"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"/>

                </LinearLayout>


                <!-- SIDE -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">


                    <ImageView
                        android:id="@+id/imgHistorySide"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:contentDescription="Side fitness photo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_person"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"

                        android:text="Side"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"/>

                </LinearLayout>


                <!-- BACK -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">


                    <ImageView
                        android:id="@+id/imgHistoryBack"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="Back fitness photo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_person"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"

                        android:text="Back"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>