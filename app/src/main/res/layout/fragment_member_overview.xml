<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">


        <!-- ================================================= -->
        <!-- ROW 1                                             -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <!-- PERSONAL INFORMATION -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_dashboard_card">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal Information"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtOverviewFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Full Name"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>


                <TextView
                    android:id="@+id/txtOverviewGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Gender"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>


                <TextView
                    android:id="@+id/txtOverviewDob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Date of Birth"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>


                <TextView
                    android:id="@+id/txtOverviewNic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="NIC"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>

            </LinearLayout>


            <!-- CONTACT -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_dashboard_card">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtOverviewMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Mobile"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>


                <TextView
                    android:id="@+id/txtOverviewEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Email"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>


                <TextView
                    android:id="@+id/txtOverviewAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Address"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>


                <TextView
                    android:id="@+id/txtOverviewCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="City"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ROW 2                                             -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">


            <!-- EMERGENCY -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_dashboard_card">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emergency Contact"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtOverviewEmergencyName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Name"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>


                <TextView
                    android:id="@+id/txtOverviewEmergencyMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Mobile"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>


                <TextView
                    android:id="@+id/txtOverviewEmergencyRelationship"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Relationship"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>

            </LinearLayout>


            <!-- HEALTH & GOALS -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_dashboard_card">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Health &amp; Goals"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtOverviewOccupation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Occupation"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>


                <TextView
                    android:id="@+id/txtOverviewBloodGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Blood Group"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>


                <TextView
                    android:id="@+id/txtOverviewMedical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Medical Conditions"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>


                <TextView
                    android:id="@+id/txtOverviewGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Goal"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ROW 3                                             -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">


            <!-- GYM INFORMATION -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_dashboard_card">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gym Information"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtOverviewBranch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Branch"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>


                <TextView
                    android:id="@+id/txtOverviewJoinDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Join Date"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>

            </LinearLayout>


            <!-- NOTES -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_dashboard_card">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notes"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtOverviewNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="-"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:maxLines="4"
                    android:ellipsize="end"/>

            </LinearLayout>

        </LinearLayout>


        <!-- BOTTOM SPACE -->

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"/>

    </LinearLayout>

</ScrollView>