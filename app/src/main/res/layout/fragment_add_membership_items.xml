<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="@color/login_background">


    <!-- ================================================= -->
    <!-- HEADER                                            -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"

        android:gravity="center_vertical"

        android:paddingStart="20dp"
        android:paddingEnd="12dp">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Add to Membership"

                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold"/>


            <TextView
                android:id="@+id/txtAddMembershipMember"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="2dp"

                android:text="Member • MEM-000001"

                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>

        </LinearLayout>


        <!-- ============================================= -->
        <!-- CLOSE                                         -->
        <!-- ============================================= -->

        <ImageButton
            android:id="@+id/btnCloseAddMembership"

            android:layout_width="42dp"
            android:layout_height="42dp"

            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_close"

            android:contentDescription="Close"/>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- TAB BAR                                           -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/addMembershipTabs"

        android:layout_width="match_parent"
        android:layout_height="52dp"

        android:orientation="horizontal">


        <!-- ============================================= -->
        <!-- PROGRAM                                       -->
        <!-- ============================================= -->

        <TextView
            android:id="@+id/tabAddProgram"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"

            android:text="Program"

            android:textColor="@color/green_light"
            android:textSize="13sp"
            android:textStyle="bold"

            android:background="@drawable/bg_tab_selected"/>


        <!-- ============================================= -->
        <!-- BENEFIT                                       -->
        <!-- ============================================= -->

        <TextView
            android:id="@+id/tabAddBenefit"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"

            android:text="Benefit"

            android:textColor="@color/text_secondary"
            android:textSize="13sp"/>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- CONTENT                                           -->
    <!-- ================================================= -->

    <FrameLayout
        android:id="@+id/addMembershipContent"

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1">


        <!-- ============================================= -->
        <!-- PROGRAMS                                      -->
        <!-- ============================================= -->

        <LinearLayout
            android:id="@+id/containerAddPrograms"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical">


            <TextView
                android:id="@+id/txtNoAddPrograms"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:padding="24dp"

                android:gravity="center"

                android:text="No programs available."

                android:textColor="@color/text_secondary"
                android:textSize="13sp"

                android:visibility="gone"/>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerAddPrograms"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:clipToPadding="false"

                android:padding="12dp"

                android:nestedScrollingEnabled="true"/>

        </LinearLayout>


        <!-- ============================================= -->
        <!-- BENEFITS                                      -->
        <!-- ============================================= -->

        <LinearLayout
            android:id="@+id/containerAddBenefits"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical"

            android:visibility="gone">


            <TextView
                android:id="@+id/txtNoAddBenefits"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:padding="24dp"

                android:gravity="center"

                android:text="No benefits available."

                android:textColor="@color/text_secondary"
                android:textSize="13sp"

                android:visibility="gone"/>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerAddBenefits"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:clipToPadding="false"

                android:padding="12dp"

                android:nestedScrollingEnabled="true"/>

        </LinearLayout>


    </FrameLayout>

</LinearLayout>