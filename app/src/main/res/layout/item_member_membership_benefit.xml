<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="10dp"

    app:cardBackgroundColor="@color/login_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/login_stroke"
    app:strokeWidth="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="16dp">


        <!-- ================================================= -->
        <!-- HEADER                                            -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"

                android:padding="9dp"

                android:src="@drawable/ic_card_giftcard"
                android:contentDescription="Benefit"

                android:background="@drawable/bg_icon_button"/>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_marginStart="12dp"
                android:layout_weight="1"

                android:orientation="vertical">


                <TextView
                    android:id="@+id/txtBenefitName"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Personal Training"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtBenefitCode"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="PT-001"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"/>

            </LinearLayout>


            <TextView
                android:id="@+id/txtBenefitType"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"

                android:text="INCLUDED"
                android:textColor="@color/green_light"
                android:textSize="9sp"
                android:textStyle="bold"

                android:background="@drawable/bg_status_badge"/>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- DIVIDER                                            -->
        <!-- ================================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"

            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"

            android:background="@color/login_stroke"/>


        <!-- ================================================= -->
        <!-- INFORMATION                                        -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal">


            <!-- FEE -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="FEE"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtBenefitFee"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="Rs. 0.00"
                    android:textColor="@color/green_light"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- DATES -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="2"

                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="VALIDITY"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/txtBenefitDates"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="27 Aug 2026  →  26 Oct 2026"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- STATUS -->

            <TextView
                android:id="@+id/txtBenefitStatus"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_gravity="center_vertical"

                android:text="ACTIVE"
                android:textColor="@color/green_light"
                android:textSize="10sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>